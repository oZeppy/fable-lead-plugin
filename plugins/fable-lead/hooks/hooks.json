{
  "description": "fable-lead: flag Fable-pinned subagents that a fallback model served (their results are not Fable results)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/fable-lead-fallback-check\" --hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/fable-lead-fallback-check\" --hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
